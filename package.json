{
  "name": "bleep-setup-action",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Github action which lets you use the Bleep JVM build tool",
  "main": "lib/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "package": "rollup --config rollup.config.ts --configPlugin @rollup/plugin-typescript",
    "all": "npm run build && npm run format && npm run lint && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bleep-build/setup-action"
  },
  "keywords": [
    "actions",
    "scala",
    "java",
    "setup",
    "bleep"
  ],
  "author": "Øyvind Raddum Berg",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.1.0",
    "eslint-plugin-github": "^6.0.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.5.0",
    "rollup": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0"
  }
}
